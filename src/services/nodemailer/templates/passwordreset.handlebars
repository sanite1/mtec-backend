<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MTEC Password Reset Request</title>
    <style>
      body {
        font-family: "Inter", Arial, sans-serif;
        background-color: #f5f7fa;
        margin: 0;
        padding: 0;
        color: #333333;
      }

      .container {
        max-width: 600px;
        margin: 0 auto 10px;
        background: #ffffff;
        padding: 1px 30px 30px;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
      }

      .header {
        text-align: center;
        border-bottom: 2px solid #eaeaea;
        padding-bottom: 5px;
      }

      .header img {
        max-width: 160px;
      }

      .header p {
        color: #7c3aed;
        font-size: 36px;
        font-weight: 700;
      }

      h2 {
        color: #0e1e46;
        font-size: 22px;
        margin-top: 30px;
        text-align: center;
      }

      p {
        color: #555;
        font-size: 16px;
        line-height: 1.6;
      }

      .button {
        display: inline-block;
        background: linear-gradient(90deg, #7c3aed, #7c3aed);
        color: #ffffff;
        padding: 10px 20px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        letter-spacing: 0.3px;
        margin-top: 5px;
        text-align: center;
      }

      .button:hover {
        opacity: 0.9;
      }

      .content {
        padding: 20px 0;
      }

      .footer {
        border-top: 1px solid #eaeaea;
        margin-top: 30px;
        padding-top: 15px;
        font-size: 13px;
        color: #888;
        text-align: center;
        line-height: 1.5;
      }

      .footer a {
        color: #7c3aed;
        text-decoration: none;
      }

      .footer a:hover {
        text-decoration: underline;
      }

      @media (max-width: 600px) {
        .container {
          margin: 20px;
          padding: 25px 20px;
        }
        h2 {
          font-size: 20px;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <!-- Header -->
      <div class="header">
        {{! <img
          src="https://res.cloudinary.com/dv4uk8qqc/image/upload/v1742470541/MTEC_Users/i66ramiru2d9doyfo7hx.png"
          alt="MTEC Logo"
        /> }}

        <p>
          MTEC
        </p>
      </div>

      <!-- Content -->
      <div class="content">
        <h2>Password Reset Request</h2>
        <p>Hi {{name}},</p>
        <p>
          We received a request to reset your MTEC password. Click the button
          below to securely reset it:
        </p>

        <div style="text-align: center;">
          <a href="{{url}}" class="button">Reset Password</a>
        </div>

        <p>
          If you didn’t request this, you can safely ignore this email. Your
          password will remain unchanged.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>
          &copy;
          {{currentYear}}
          MTEC. All rights reserved.<br />
          Need help? Contact us at
          <a href="mailto:support@bitec.store">support@mtec.com</a>
        </p>
      </div>
    </div>
  </body>
</html>