<html>
  <head>
    <meta charset="UTF-8" />
    <title>Order Pending Payment - MTEC</title>
    <style>
      body {
        font-family: Inter, Arial, sans-serif;
        background-color: #f5f7fa;
        margin: 0;
        padding: 0;
        color: #333;
      }
      .container {
        max-width: 600px;
        margin: 20px auto;
        background: #ffffff;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
      }
      .header {
        text-align: center;
        border-bottom: 1px solid #eee;
        padding-bottom: 10px;
      }
      .header h1 {
        color: #7c3aed;
        margin: 0;
      }
      h2 {
        text-align: center;
        color: #0e1e46;
      }
      .box {
        background: #f9fafb;
        padding: 16px;
        border-radius: 8px;
        margin-bottom: 16px;
      }
      .row {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        margin-bottom: 6px;
      }
      .items {
        border: 1px solid #eee;
        border-radius: 8px;
        overflow: hidden;
      }
      .item {
        padding: 12px;
        border-bottom: 1px solid #eee;
        display: flex;
        justify-content: space-between;
        font-size: 14px;
      }
      .item:last-child {
        border-bottom: none;
      }
      .total {
        font-weight: bold;
      }
      .button {
        display: block;
        margin: 20px auto 0;
        background: #7c3aed;
        color: #fff;
        padding: 12px;
        text-align: center;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
      }
      .footer {
        margin-top: 20px;
        font-size: 12px;
        color: #888;
        text-align: center;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <h1>MTEC</h1>
      </div>

      <h2>New Order Awaiting Payment</h2>
      <p>Hello {{merchantName}},</p>
      <p>A new order has been placed in your store but payment is yet to be
        confirmed.</p>

      <!-- Order Summary -->
      <div class="box">
        <div class="row"><span>Order No:</span><span
          >{{orderNumber}}</span></div>
        <div class="row"><span>Date:</span><span>{{orderDate}}</span></div>
        <div class="row"><span>Status:</span><span>{{orderStatus}}</span></div>
        <div class="row"><span>Payment:</span><span>{{paymentStatus}}
            ({{paymentMethod}})</span></div>
      </div>

      <!-- Shipping -->
      <div class="box">
        <strong>Shipping Information</strong>
        <p>{{shipping.fullName}}</p>
        <p>{{shipping.phone}} | {{shipping.email}}</p>
        <p>{{shipping.address1}}</p>
        {{#if shipping.address2}}<p>{{shipping.address2}}</p>{{/if}}
        <p>{{shipping.city}}, {{shipping.state}}, {{shipping.country}}</p>
      </div>

      <!-- Items -->
      <div class="items">
        {{#each items}}
          <div class="item">
            <div>
              <strong>{{name}}</strong><br />
              <small>{{sku}}</small><br />
              <small>Qty: {{quantity}} × {{price}}</small>
            </div>
            <strong>{{subtotal}}</strong>
          </div>
        {{/each}}
      </div>

      <!-- Totals -->
      <div class="box">
        <div class="row"><span>Subtotal</span><span
          >{{totals.subtotal}}</span></div>
        <div class="row"><span>Shipping</span><span
          >{{totals.shipping}}</span></div>
        <div class="row"><span>Tax</span><span>{{totals.tax}}</span></div>
        <div class="row"><span>Discount</span><span
          >{{totals.discount}}</span></div>
        <div class="row total"><span>Total</span><span
          >{{totals.total}}</span></div>
      </div>

      <a href="{{orderUrl}}" class="button">Complete Payment</a>

      <div class="footer">
        © 2025 MTEC · support@mtec.com
      </div>
    </div>
  </body>
</html>