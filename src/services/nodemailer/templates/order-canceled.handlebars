<html>
  <head>
    <meta charset="UTF-8" />
    <title>Order Cancelled</title>
  </head>

  <body
    style="
      margin:0;
      padding:0;
      background:#f5f7fa;
      font-family:Arial, sans-serif;
      color:#333;
    "
  >
    <div>
      <div style="padding:20px;">
        <!-- Card -->
        <div
          style="
            max-width:600px;
            margin:0 auto;
            background:#ffffff;
            border-radius:12px;
            padding:20px;
            box-shadow:0 8px 25px rgba(0,0,0,0.08);
          "
        >

          <!-- Header -->
          <div
            style="padding-bottom:16px; border-bottom:1px solid #eee; text-align:center;"
          >
            {{#if storeLogo}}
              <img
                src="{{storeLogo}}"
                alt="Store Logo"
                width="120"
                style="display:block; margin:auto;"
              />
            {{else}}
              <strong style="font-size:18px;">{{merchantName}}</strong>
            {{/if}}
          </div>

          <!-- Title -->
          <h2
            style="
              text-align:center;
              margin:16px 0;
            "
          >
            ❌ Order Cancelled
          </h2>

          <!-- Message -->
          <p style="font-size:14px; line-height:1.6; padding-bottom:16px;">
            Hello
            {{merchantName}},
            <br /><br />
            The order below has been
            <strong>cancelled</strong>. No further action is required for this
            order.
          </p>

          <!-- Status Card -->
          <div
            style="
              background:#f9fafb;
              border-radius:8px;
              padding:16px;
              margin-bottom:20px;
            "
          >
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              style="font-size:14px;"
            >
              <tr>
                <td style="color:#666; padding:6px 0;">Order Number:</td>
                <td align="right" style="font-weight:600;">
                  {{orderNumber}}
                </td>
              </tr>

              <tr>
                <td style="color:#666; padding:6px 0;">Current Status:</td>
                <td align="right" style="font-weight:600; color:#b91c1c;">
                  Cancelled
                </td>
              </tr>

              {{#if cancelledAt}}
                <tr>
                  <td style="color:#666; padding:6px 0;">Cancelled On:</td>
                  <td align="right" style="font-weight:600;">
                    {{cancelledAt}}
                  </td>
                </tr>
              {{/if}}

              {{#if cancellationReason}}
                <tr>
                  <td style="color:#666; padding:6px 0;">Reason:</td>
                  <td align="right" style="font-weight:600;">
                    {{cancellationReason}}
                  </td>
                </tr>
              {{/if}}
            </table>
          </div>

          <!-- CTA -->
          <div align="center" style="padding-top:10px;">
            <a
              href="{{orderUrl}}"
              style="
                display:inline-block;
                background: {{storeColor}};
                color:#ffffff;
                padding:12px 20px;
                text-decoration:none;
                border-radius:8px;
                font-weight:600;
              "
            >
              View Order
            </a>
          </div>

          <!-- Footer -->
          <p
            align="center"
            style="padding-top:20px; font-size:12px; color:#888;"
          >
            ©
            {{currentYear}}
            {{merchantName}}
            ·
            {{storeEmail}}
          </p>

        </div>
      </div>
    </div>
  </body>
</html>