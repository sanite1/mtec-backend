<html>
  <head>
    <meta charset="UTF-8" />
    <title>Payment Confirmed</title>
  </head>

  <body
    style="margin:0; padding:0; background:#f5f7fa; font-family:Arial, sans-serif; color:#333;"
  >
    <table width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center" style="padding:20px;">
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            style="background:#ffffff; border-radius:12px; padding:20px;"
          >

            <!-- Header -->
            <tr>
              <td
                align="center"
                style="padding-bottom:16px; border-bottom:1px solid #eee;"
              >
                {{#if storeLogo}}
                  <img
                    src="{{storeLogo}}"
                    alt="Store Logo"
                    width="120"
                    style="display:block; margin:auto;"
                  />
                {{else}}
                  <strong style="font-size:18px;">{{merchantName}}</strong>
                {{/if}}
              </td>
            </tr>

            <!-- Title -->
            <tr>
              <td align="center" style="padding:20px 0;">
                <h2 style="margin:0; color:#0e1e46;">
                  ✅ Payment Confirmed
                </h2>
              </td>
            </tr>

            <!-- Message -->
            <tr>
              <td style="font-size:14px; line-height:1.6; padding-bottom:16px;">
                Hello
                {{buyerName}},
                <br /><br />
                We’re happy to inform you that payment for the order below has
                been
                <strong>successfully received and confirmed</strong>.
              </td>
            </tr>

            <!-- Order Summary -->
            <tr>
              <td style="background:#f9fafb; border-radius:8px; padding:16px;">
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="5px"
                  style="font-size:14px;"
                >
                  <tr>
                    <span
                      style="color:#666; padding:4px 0; margin-right: 3px;"
                    >Order Number:</span>
                    <span
                      align="right"
                      style="font-weight:500; padding:4px 0;"
                    >{{orderNumber}}</span>
                  </tr>
                  <tr>
                    <span
                      style="color:#666; padding:4px 0; margin-right: 3px;"
                    >Amount Paid:</span>
                    <span
                      align="right"
                      style="font-weight:500; padding:4px 0;"
                    >{{totals.total}}</span>
                  </tr>
                  <tr>
                    <span
                      style="color:#666; padding:4px 0; margin-right: 3px;"
                    >Payment Method:</span>
                    <span
                      align="right"
                      style="font-weight:500; padding:4px 0;"
                    >{{paymentMethod}}</span>
                  </tr>
                  <tr>
                    <span
                      style="color:#666; padding:4px 0; margin-right: 3px;"
                    >Payment Date:</span>
                    <span
                      align="right"
                      style="font-weight:500; padding:4px 0;"
                    >{{paymentDate}}</span>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- CTA -->
            <tr>
              <td align="center" style="padding-top:20px;">
                <a
                  href="{{orderUrl}}"
                  style="
                    display:inline-block;
                    background: {{storeColor}};
                    color:#ffffff;
                    padding:12px 20px;
                    text-decoration:none;
                    border-radius:8px;
                    font-weight:600;
                  "
                >
                  View Order
                </a>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="padding-top:20px; font-size:12px; color:#888;"
              >
                ©
                {{currentYear}}
                {{merchantName}}
                ·
                {{storeEmail}}
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>