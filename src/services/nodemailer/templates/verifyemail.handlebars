<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MTEC Email Confirmation</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: linear-gradient(180deg, #f9f6ff 0%, #f3e8ff 100%);
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
        color: #333;
      }

      .wrapper {
        width: 100%;
        padding: 40px 20px;
      }

      .container {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(124, 58, 237, 0.15);
        border: 1px solid #ede9fe;
      }

      /* HEADER */
      .header {
        background: linear-gradient(135deg, #6d28d9, #9333ea, #a855f7);
        text-align: center;
        padding: 50px 30px;
        position: relative;
      }

      .header::after {
        content: "";
        position: absolute;
        bottom: -25px;
        left: 50%;
        transform: translateX(-50%);
        width: 80%;
        height: 50px;
        background: radial-gradient(
          circle,
          rgba(255, 255, 255, 0.2),
          transparent 70%
        );
        border-radius: 50%;
      }

      .header img {
        max-width: 120px;
        margin-bottom: 18px;
      }

      .header h1 {
        color: #fff;
        font-size: 26px;
        font-weight: 700;
        letter-spacing: 0.4px;
        margin: 0;
      }

      /* CONTENT */
      .content {
        padding: 45px 35px 50px 35px;
        text-align: left;
      }

      .greeting {
        font-size: 20px;
        font-weight: 600;
        color: #3b0764;
        margin-bottom: 10px;
      }

      .message {
        color: #4b5563;
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 16px;
      }

      .highlight {
        background: #f3e8ff;
        padding: 12px 16px;
        border-left: 4px solid #7c3aed;
        border-radius: 8px;
        margin: 20px 0;
        font-size: 15px;
        color: #1f2937;
      }

      .button {
        display: inline-block;
        background: linear-gradient(90deg, #7c3aed, #6d28d9);
        color: #ffffff !important;
        padding: 14px 32px;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 16px;
        margin-top: 30px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);
      }

      .button:hover {
        background: linear-gradient(90deg, #6d28d9, #5b21b6);
        box-shadow: 0 6px 18px rgba(124, 58, 237, 0.35);
      }

      /* FOOTER */
      .footer {
        background: #faf5ff;
        text-align: center;
        padding: 30px 20px;
        font-size: 13px;
        color: #6b7280;
        border-top: 1px solid #ede9fe;
      }

      .footer a {
        color: #7c3aed;
        text-decoration: none;
        font-weight: 500;
      }

      .footer a:hover {
        text-decoration: underline;
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header -->
        <div class="header">
          <img
            src="https://res.cloudinary.com/dv4uk8qqc/image/upload/v1742470541/MTEC_Users/i66ramiru2d9doyfo7hx.png"
            alt="MTEC Logo"
          />
          <h1>Verify Your Email Address</h1>
        </div>

        <!-- Content -->
        <div class="content">
          <p class="greeting">Hi {{name}},</p>

          <p class="message">
            Welcome to
            <strong>MTEC</strong>
            🎉<br />
            We're thrilled to have you onboard. To keep your account secure,
            please confirm your email address.
          </p>

          <div class="highlight">
            <strong>Email:</strong>
            {{email}}<br />
            <small>Once confirmed, you’ll have full access to your dashboard.</small>
          </div>

          <a href="{{url}}" class="button">Confirm My Email</a>

          <p class="message" style="margin-top: 30px">
            Didn’t create an account? No worries — you can safely ignore this
            message. Your account won’t be activated without verification.
          </p>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>&copy; 2025 MTEC. All rights reserved.</p>
          <p>
            Need help? Reach us at
            <a href="mailto:support@bitec.store">support@bitec.store</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>