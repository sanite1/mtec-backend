<html>
  <head>
    <meta charset="UTF-8" />
    <title>Order Needs Shipping</title>
    <style>
      body {
        font-family: Inter, Arial, sans-serif;
        background-color: #f5f7fa;
        margin: 0;
        padding: 0;
        color: #333;
      }
      .container {
        max-width: 600px;
        margin: 20px auto;
        background: #ffffff;
        padding: 14px;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
      }
      .header {
        text-align: center;
        border-bottom: 1px solid #eee;
        padding-bottom: 10px;
      }
      .header h1 {
        color: #7c3aed;
        margin: 0;
      }
      h2 {
        text-align: center;
        color: #0e1e46;
      }
      .box {
        background: #f9fafb;
        padding: 16px;
        border-radius: 8px;
        margin-bottom: 16px;
      }
      .row {
        display: flex;
        width: 100%;
        justify-content: space-between;
        font-size: 14px;
        margin-bottom: 6px;
      }
      .items {
        border: 1px solid #eee;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 16px;
      }

      .item-row {
        border-bottom: 1px solid #eee;
      }

      .text {
        font-size: 14px;
      }
      .item-cell {
        padding: 12px;
        font-size: 14px;
        vertical-align: top;
        border-bottom: 1px solid #eee;
      }

      .item-row:last-child .item-cell {
        border-bottom: none;
      }

      .item-price {
        text-align: right;
        white-space: nowrap;
        font-weight: bold;
      }

      .total {
        font-weight: bold;
      }
      .button {
        display: block;
        margin: 20px auto 0;
        background: #7c3aed;
        color: #fff;
        padding: 12px;
        text-align: center;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
      }
      .footer {
        margin-top: 20px;
        font-size: 12px;
        color: #888;
        text-align: center;
      }
    </style>
  </head>

  <body
    style="
      margin:0;
      padding:0;
      background:#f5f7fa;
      font-family:Arial, sans-serif;
      color:#333;
    "
  >

    <div>
      <div style="padding:20px;">
        <!-- Card -->
        <div
          width="600"
          cellpadding="0"
          cellspacing="0"
          style="
              background:#ffffff;
              border-radius:12px;
              padding:20px;
              box-shadow:0 8px 25px rgba(0,0,0,0.08);
            "
        >

          <!-- Header -->
          <div>
            <div
              align="center"
              style="padding-bottom:16px; border-bottom:1px solid #eee;"
            >
              {{#if storeLogo}}
                <img
                  src="{{storeLogo}}"
                  alt="Store Logo"
                  width="120"
                  style="display:block; margin:auto;"
                />
              {{else}}
                <strong style="font-size:18px;">{{merchantName}}</strong>
              {{/if}}
            </div>
          </div>

          <!-- Title -->
          <h2 align="center" style="margin:10px auto; color:#0e1e46;">
            📦 Order Ready for Shipping
          </h2>

          <!-- Message -->
          <p style="font-size:14px; line-height:1.6; padding-bottom:16px;">
            Hello
            {{merchantName}},
            <br /><br />
            An order in your store has been
            <strong>successfully paid and confirmed</strong>.
            <br />
            Please prepare and ship the order to the customer.
          </p>

          <!-- Order Summary -->
          <div class="box">
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              style="font-size:14px; margin-bottom:10px;"
            >
              <tr>
                <td style="color:#666; padding:4px 0;">Order No:</td>
                <td align="right" style="font-weight:600; padding:4px 0;">
                  {{orderNumber}}
                </td>
              </tr>
              <tr>
                <td style="color:#666; padding:4px 0;">Date:</td>
                <td align="right" style="font-weight:600; padding:4px 0;">
                  {{orderDate}}
                </td>
              </tr>
              <tr>
                <td style="color:#666; padding:4px 0;">Status:</td>
                <td align="right" style="font-weight:600; padding:4px 0;">
                  {{orderStatus}}
                </td>
              </tr>
              <tr>
                <td style="color:#666; padding:4px 0;">Payment:</td>
                <td align="right" style="font-weight:600; padding:4px 0;">
                  {{paymentStatus}}
                  ({{paymentMethod}})
                </td>
              </tr>
            </table>
          </div>

          <!-- Shipping -->
          <div class="box">
            <strong class="text">Shipping Information</strong>
            <p class="text">{{shipping.fullName}}</p>
            <p class="text">{{shipping.phone}} | {{shipping.email}}</p>
            <p class="text">{{shipping.address1}}</p>
            {{#if shipping.address2}}<p
                class="text"
              >{{shipping.address2}}</p>{{/if}}
            <p class="text">{{shipping.city}},
              {{shipping.state}},
              {{shipping.country}}</p>
          </div>

          <!-- Items -->
          <div class="items">
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              role="presentation"
            >
              {{#each items}}
                <tr class="item-row">
                  <td class="item-cell">
                    <strong>{{name}}</strong><br />
                    <small>{{sku}}</small><br />
                    <small>Qty: {{quantity}} × {{price}}</small>
                  </td>
                  <td class="item-cell item-price">
                    {{subtotal}}
                  </td>
                </tr>
              {{/each}}
            </table>
          </div>

          <!-- Totals -->
          <div class="box">
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              style="font-size:14px; margin-bottom:10px;"
            >
              <tr>
                <td style="color:#666; padding:4px 0;">Subtotal:</td>
                <td align="right" style="font-weight:600; padding:4px 0;">
                  {{totals.subtotal}}
                </td>
              </tr>
              <tr>
                <td style="color:#666; padding:4px 0;">Shipping:</td>
                <td align="right" style="font-weight:600; padding:4px 0;">
                  {{totals.shipping}}
                </td>
              </tr>
              <tr>
                <td style="color:#666; padding:4px 0;">Tax:</td>
                <td align="right" style="font-weight:600; padding:4px 0;">
                  {{totals.tax}}
                </td>
              </tr>
              <tr>
                <td style="color:#666; padding:4px 0;">Discount:</td>
                <td align="right" style="font-weight:600; padding:4px 0;">
                  {{totals.discount}}
                </td>
              </tr>
              <tr>
                <td style="color:#666; padding:4px 0;">Total:</td>
                <td align="right" style="font-weight:600; padding:4px 0;">
                  {{totals.total}}
                </td>
              </tr>
            </table>
          </div>

          <!-- CTA -->
          <div align="center" style="padding-top:20px;">
            <a
              href="{{adminOrderUrl}}"
              style="
                    display:inline-block;
                    background: {{storeColor}};
                    color:#ffffff;
                    padding:12px 20px;
                    text-decoration:none;
                    border-radius:8px;
                    font-weight:600;
                  "
            >
              View & Fulfil Order
            </a>
          </div>

          <!-- Footer -->
          <p
            align="center"
            style="padding-top:20px; font-size:12px; color:#888;"
          >
            © 2025
            {{currentYear}}
            · support@mtec.com
          </p>

        </div>
      </div>
    </div>
  </body>
</html>